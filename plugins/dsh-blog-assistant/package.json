{
  "name": "dsh-blog-assistant",
  "version": "0.11.1",
  "description": "个人博客写作、发布、图床与备份助手",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./protocol": {
      "default": "./dist/protocol.mjs",
      "types": "./dist/protocol.d.mts"
    }
  },
  "files": [
    "dist/",
    "web/index.html",
    "web/style.css",
    "web/icons.svg",
    "web/ICONS-LICENSE.txt",
    "config/config.example.json",
    "config/README.md",
    "backup/archive.py",
    "backup/executor.py",
    "backup/chat-state.mjs",
    "backup/install.py",
    "backup/config.example.json",
    "backup/README.md",
    "runtime/",
    "typecho/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "APACHE-2.0.txt",
    "web/chat-base.css",
    "web/chat-theme.css",
    "web/media/",
    "web/writing.css"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "runtimeConfig": {
      "variable": "BLOG_CONFIG_PATH",
      "required": true,
      "template": "config/config.example.json"
    },
    "defaultEnabled": false,
    "id": "blog",
    "permissions": [
      "blog:access"
    ],
    "healthPath": "/blog/ready",
    "entryPath": "/blog",
    "configuration": {
      "entryId": "blog",
      "auth": "consumer"
    },
    "verifyFiles": [
      "dist/web/app.js",
      "web/index.html",
      "web/model-picker.js",
      "web/media/icon-chevron-down.svg",
      "web/media/icon-check.svg",
      "web/style.css",
      "config/config.example.json",
      "typecho/DshBlogBridge/Plugin.php",
      "typecho/DshBlogBridge/Action.php",
      "typecho/DshBlogBridge/Management.php",
      "web/chat-base.css",
      "web/chat-theme.css",
      "web/media/icon-copy.svg",
      "web/writing.css"
    ],
    "displayName": "博客工作台",
    "schemaVersion": 3
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/native-drafts.test.mjs tests/management.test.mjs tests/clipboard.test.mjs tests/attachments.test.mjs tests/chat-store.test.mjs tests/chat.test.mjs tests/chat-ui.test.mjs tests/article-diff.test.mjs tests/drafts.test.mjs tests/jobs.test.mjs tests/models.test.mjs tests/search.test.mjs",
    "test:host": "node --test tests/http.test.mjs tests/chat-history-native.test.mjs tests/chat-backup-native.test.mjs",
    "test:bridge": "php -n -l typecho/DshBlogBridge/Plugin.php && php -n tests/management-bridge.test.php",
    "check": "pnpm typecheck && node --check web/app.js",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-message-feedback": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5 || 0.1.3-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-message-feedback": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-jobs-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-message-feedback": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "dompurify": "3.4.14",
    "markdown-it": "15.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
