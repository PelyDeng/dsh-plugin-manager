{
  "name": "dsh-butler-console",
  "version": "0.12.3",
  "description": "DSH 牛马大总管：统一对话入口、任务拆解与子 Agent 调度状态页",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "web/",
    "migrations/postgres/0001_init.sql",
    "config/storage.example.json",
    "persona.txt",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "butler",
    "displayName": "牛马聊天群",
    "category": "web-services",
    "entryPath": "/butler",
    "healthPath": "/butler/ready",
    "permissions": [
      "butler:access"
    ],
    "verifyFiles": [
      "persona.txt",
      "web/index.html",
      "web/style.css",
      "web/app.js",
      "web/api.js",
      "web/stream.js",
      "dist/web/app.js",
      "migrations/postgres/0001_init.sql",
      "dist/migrate-storage.mjs"
    ],
    "runtimeConfig": {
      "variable": "BUTLER_PG_CONFIG",
      "template": "config/storage.example.json"
    },
    "configuration": {
      "entryId": "butler",
      "auth": "consumer"
    }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web.config.ts",
    "build:react": "tsdown && tsdown --config tsdown.web-react.config.ts && tailwindcss -i web-react/src/styles/app.css -o dist/web/app.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && node --check web/app.js && node --check web/api.js && node --check web/stream.js && node --check web/markdown.js && node --check web/modules/config.js && node --check web/modules/state.js && node --check web/modules/dom.js && node --check web/modules/rail.js && node --check web/modules/speech.js && node --check web/modules/member.js && node --check web/modules/dcard.js && node --check web/modules/attachments.js && node --check web/modules/panels.js && node --check web/modules/history.js && node --check web/modules/cards.js && node --check web/modules/events.js && node --check web/modules/send.js && node --check web/modules/composer.js && node scripts/check-web-cycles.mjs && node scripts/check-module-leaks.mjs",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.34.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.107",
    "ansi-to-react": "^6.2.6",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "mammoth": "1.12.2",
    "media-chrome": "^4.19.2",
    "motion": "^13.4.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "6.3.289",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@dsh-agents-group/document-parse": "workspace:*",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "^20.14.5",
    "lucide-react": "1.47.0",
    "markdown-it": "15.0.1",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
