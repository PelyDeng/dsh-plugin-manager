{
  "name": "dsh-butler-console",
  "version": "0.14.3",
  "description": "DSH 牛马大总管：统一对话入口、任务拆解与子 Agent 调度状态页",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "web/",
    "web-react/",
    "migrations/postgres/0001_init.sql",
    "config/storage.example.json",
    "persona/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "butler",
    "displayName": "牛马聊天群",
    "category": "web-services",
    "entryPath": "/butler",
    "healthPath": "/butler/ready",
    "permissions": [
      "butler:access"
    ],
    "verifyFiles": [
      "persona/identity.md",
      "persona/tools.md",
      "web-react/index.html",
      "web/media/avatars/avatar-butler.png",
      "web/fonts-lxgw.css",
      "dist/web/app.js",
      "dist/web/app.css",
      "migrations/postgres/0001_init.sql",
      "dist/migrate-storage.mjs"
    ],
    "runtimeConfig": {
      "variable": "BUTLER_PG_CONFIG",
      "template": "config/storage.example.json"
    },
    "configuration": {
      "entryId": "butler",
      "auth": "consumer"
    }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web-react.config.ts && tailwindcss -i web-react/src/styles/app.css -o dist/web/app.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && node scripts/check-web-react.mjs",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@dsh-agents-group/document-parse": "workspace:*",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^20.14.5",
    "markdown-it": "15.0.1",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zustand": "5.0.8"
  }
}
