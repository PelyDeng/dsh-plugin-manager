{
  "name": "dsh-agents-group",
  "version": "0.10.3",
  "description": "DSH 智能体群组：统一分包管理多个智能体，共享公共组件，各自独立页面与授权",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "agents/",
    "config/group.example.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "agents-group",
    "displayName": "智能体群组",
    "category": "web-services",
    "entryPath": "/agents",
    "healthPath": "/agents/health",
    "permissions": [
      "agents-group:access"
    ],
    "verifyFiles": [
      "config/group.example.json",
      "agents/closedoff/persona.txt",
      "agents/closedoff/web/index.html",
      "agents/blog/runtime/chat-sdk.mjs",
      "agents/blog/dist/web/app.js",
      "agents/blog/migrations/postgres/0001_init.sql",
      "agents/huiyu/package.json",
      "dist/migrate-blog-storage.mjs"
    ],
    "configuration": {
      "entryId": "agents-group",
      "auth": "consumer"
    },
    "runtimeConfig": {
      "variable": "AGENTS_GROUP_CONFIG",
      "template": "config/group.example.json"
    },
    "development": {
      "patch": "dev/dev-hmr.patch.yml",
      "rootVariable": "AGENTS_GROUP_DEV_ROOT"
    }
  },
  "scripts": {
    "build": "pnpm --filter @dsh-agents-group/closedoff run build && pnpm --filter @dsh-agents-group/blog run build && pnpm --filter @dsh-agents-group/huiyu run build && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && node agents/huiyu/scripts/generate-contract.mjs --check && node tests/contract-guard.mjs && node tests/tokens-hash.mjs",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-message-feedback": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@dsh-agents-group/common": "workspace:*",
    "@dsh-agents-group/runtime": "workspace:*",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "pg": "^8.16.0"
  }
}
