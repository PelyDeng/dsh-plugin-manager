{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    // `lib` 显式写出来（不靠 target 推断）：P8 转 TS 后测试用了 `Promise.withResolvers`（**ES2024**），
    // 而 `target: ES2022` 的默认 lib 里没有它 ⇒ 会报 TS2550。运行时是 Node 22，本来就有这个 API。
    // 保留 `DOM` / `DOM.Iterable` 是为了与推断出的默认 lib **等价**（不缩小可用全局）。
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true, "allowJs": true, "checkJs": false, "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "declaration": true, "noEmit": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
