{
  "name": "@dsh-agents-group/blog",
  "version": "0.12.8",
  "description": "博客工作台：写作、发布、图床与备份助手（智能体群组的子包）",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.mts",
      "default": "./dist/protocol.mjs"
    }
  },
  "files": [
    "dist/",
    "web/",
    "config/config.example.json",
    "config/README.md",
    "backup/archive.py",
    "backup/executor.py",
    "backup/chat-state.mjs",
    "backup/install.py",
    "backup/config.example.json",
    "backup/README.md",
    "runtime/",
    "typecho/",
    "README.md",
    "APACHE-2.0.txt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/participant.test.mjs tests/native-drafts.test.mjs tests/management.test.mjs tests/clipboard.test.mjs tests/attachments.test.mjs tests/chat-store.test.mjs tests/chat.test.mjs tests/chat-ui.test.mjs tests/article-diff.test.mjs tests/drafts.test.mjs tests/jobs.test.mjs tests/models.test.mjs tests/search.test.mjs tests/reports.test.mjs tests/storage-wiring.test.mjs tests/definition.test.mjs",
    "test:host": "node --test tests/http.test.mjs tests/chat-history-native.test.mjs tests/chat-backup-native.test.mjs",
    "test:pg": "node --test tests/pg-smoke.test.mjs",
    "test:bridge": "php -n -l typecho/DshBlogBridge/Plugin.php && php -n tests/management-bridge.test.php",
    "test:reports": "php tests/reports-bridge.test.php",
    "check": "pnpm typecheck && node --check web/app.js",
    "clean": "node ../../../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-message-feedback": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-message-feedback": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-jobs-local": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-message-feedback": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@dsh-agents-group/common": "workspace:*",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "dompurify": "3.4.14",
    "markdown-it": "15.0.1",
    "pg": "^8.16.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
