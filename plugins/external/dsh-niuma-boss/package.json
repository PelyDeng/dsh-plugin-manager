{
  "name": "dsh-niuma-boss",
  "version": "0.2.0",
  "description": "DSH 牛马-老板：像素风职场游戏入口，复用牛马大总管的权威任务与历史",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "web/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "niuma-boss",
    "displayName": "牛马-老板",
    "category": "web-services",
    "entryPath": "/niuma-boss",
    "healthPath": "/niuma-boss/ready",
    "permissions": [
      "niuma-boss:access"
    ],
    "verifyFiles": [
      "web/index.html",
      "dist/index.mjs",
      "web/generated/office.runtime.json"
    ],
    "configuration": {
      "entryId": "niuma-boss",
      "auth": "consumer"
    }
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build": "pnpm prepare-assets && vue-tsc --noEmit && vite build && tsdown",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "test:browser": "node scripts/browser-check.mjs chromium && node scripts/browser-check.mjs edge",
    "clean": "node ../../scripts/clean-plugin.mjs dist web coverage public/generated"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "6.0.8",
    "easystarjs": "0.4.4",
    "free-tex-packer-core": "0.3.9",
    "phaser": "4.2.1",
    "pinia": "4.0.3",
    "playwright": "1.62.1",
    "tsdown": "^0.22.2",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "^4.1.8",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
