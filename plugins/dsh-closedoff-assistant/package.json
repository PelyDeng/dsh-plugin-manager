{
  "name": "dsh-closedoff-assistant",
  "version": "0.5.2",
  "description": "封闭化园区业务查询、个人对话历史与可视化助手",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "doc/",
    "dev/",
    "web/",
    "env.conf.example",
    "persona.txt",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "closedoff",
    "defaultEnabled": true,
    "configuration": { "entryId": "closedoff-assistant", "auth": "consumer" },
    "healthPath": "/closedoff-qa/ready",
    "verifyFiles": [
      "web/index.html",
      "web/model-picker.js",
      "web/assets/model-picker.js",
      "web/assets/icon-chevron-down.svg",
      "web/assets/icon-check.svg",
      "web/assets/app.css",
      "web/assets/app.js",
      "web/assets/trajectory.js"
    ],
    "development": {
      "patch": "dev/dev-hmr.patch.yml",
      "rootVariable": "CLOSEDOFF_PLUGIN_DEV_ROOT"
    },
    "displayName": "封闭化管理智能助手",
    "entryPath": "/closedoff-qa",
    "permissions": [
      "closedoff:access"
    ],
    "runtimeConfig": {
      "variable": "CLOSEDOFF_ENV_CONF",
      "required": true,
      "template": "env.conf.example"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-web-assets.mjs",
    "dev": "node scripts/dev-watch.mjs",
    "check:web": "node --check web/trajectory.js && node --check web/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm check:web && pnpm test",
    "clean": "node ../../scripts/clean-plugin.mjs dist web/assets"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-message-feedback": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.5 || 0.1.3-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-message-feedback": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hy-media/video-player": "file:vendor/hy-media-video-player-0.0.37.tgz",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-message-feedback": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@types/node": "^22.20.0",
    "cesium": "1.142.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vue": "3.5.42",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.5",
    "@dsh-plugin-manager/plugin-kit": "workspace:*"
  }
}
