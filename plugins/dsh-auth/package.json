{
  "name": "dsh-auth",
  "version": "0.8.0",
  "description": "统一管理用户账号、登录会话和插件访问权限。",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./admin": {
      "types": "./dist/store.d.mts",
      "default": "./dist/store.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "web/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/auth-admin.mjs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "auth",
    "defaultEnabled": true,
    "healthPath": "/auth/health",
    "verifyFiles": [
      "dist/store.mjs",
      "web/index.html",
      "web/app.js",
      "web/style.css",
      "web/catalog-view.js",
      "web/icons.svg"
    ],
    "displayName": "统一认证",
    "entryPath": "/auth",
    "permissions": [
      "auth:manage"
    ],
    "configuration": {
      "entryId": "auth",
      "auth": "provider"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/admin.test.mjs",
    "check:web": "node --check web/app.js && node --check web/catalog-view.js",
    "check": "pnpm typecheck && pnpm check:web",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5 || 0.1.3-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.5",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@dsh-plugin/plugin-kit": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PelyDeng/dsh-plugin.git",
    "directory": "plugins/dsh-auth"
  }
}
