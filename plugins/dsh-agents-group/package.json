{
  "name": "dsh-agents-group",
  "version": "0.1.0",
  "description": "DSH 智能体群组：统一分包管理多个智能体，共享公共组件，各自独立页面与授权",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "config/group.example.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "agents-group",
    "defaultEnabled": false,
    "displayName": "智能体群组",
    "entryPath": "/agents",
    "healthPath": "/agents/health",
    "permissions": [
      "agents-group:access"
    ],
    "verifyFiles": [
      "config/group.example.json",
      "src/agents/registry.ts"
    ],
    "configuration": {
      "entryId": "agents-group",
      "auth": "consumer"
    },
    "runtimeConfig": {
      "variable": "AGENTS_GROUP_CONFIG",
      "template": "config/group.example.json"
    },
    "development": {
      "patch": "dev/dev-hmr.patch.yml",
      "rootVariable": "AGENTS_GROUP_DEV_ROOT"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@dsh-agents-group/common": "workspace:*",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
