{
  "name": "dsh-pirate-command",
  "version": "0.2.0",
  "description": "黑珍珠号多智能体指挥台",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./protocol": { "types": "./dist/protocol.d.mts", "default": "./dist/protocol.mjs" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist/", "web/dist/", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@11.19.0",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "pirate",
    "displayName": "黑珍珠号指挥台",
    "category": "web-services",
    "entryPath": "/pirate",
    "healthPath": "/pirate/ready",
    "defaultEnabled": false,
    "permissions": ["pirate:access"],
    "configuration": { "entryId": "pirate-command", "auth": "consumer" },
    "verifyFiles": ["dist/index.mjs", "dist/protocol.mjs", "web/dist/index.html", "web/dist/assets/manifest.json"]
  },
  "scripts": {
    "build": "tsdown && vite build",
    "build:server": "tsdown",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm auditPrompts",
    "auditPrompts": "node resources/tools/audit_prompts.mjs",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.2" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "phaser": "4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "markdown-it": "15.0.1",
    "vite": "6.4.2",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
