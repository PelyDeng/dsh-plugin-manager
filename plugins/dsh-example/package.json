{
  "name": "dsh-example",
  "version": "0.15.2",
  "description": "DSH Plugin Manager 开发者接入答疑助手与可复制的鉴权对话示例",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "web/",
    "examples/",
    "knowledge/",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "skills/"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "deepseekPlugin": {
    "schemaVersion": 3,
    "id": "example",
    "defaultEnabled": true,
    "displayName": "开发者接入助手",
    "entryPath": "/example",
    "healthPath": "/example/ready",
    "permissions": [
      "example:access"
    ],
    "verifyFiles": [
      "knowledge/guide.md",
      "knowledge/prompts.md",
      "dist/framework-reference.json",
      "web/index.html",
      "web/model-picker.js",
      "web/media/icon-chevron-down.svg",
      "web/media/icon-check.svg",
      "web/app.js",
      "dist/web/app.js",
      "THIRD_PARTY_NOTICES.md",
      "web/stream.js",
      "web/style.css",
      "examples/README.md",
      "examples/plugin.json.example",
      "examples/auth.plugin.json.example",
      "examples/deployment.json.example",
      "web/chat-base.css",
      "web/chat-ui.js",
      "web/thinking-translation.js",
      "web/conversation-history.js",
      "web/media/icon-copy.svg",
      "skills/dsh-chat-style/SKILL.md",
      "skills/dsh-chat-style/references/conversation-workflows.md"
    ],
    "configuration": {
      "entryId": "example",
      "auth": "consumer"
    }
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.web.config.ts && node scripts/build-reference.mjs --root ../..",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && node --check web/app.js && node --check web/stream.js && node --check web/markdown.js",
    "clean": "node ../../scripts/clean-plugin.mjs dist coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-message-feedback": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "dsh-auth": "workspace:*",
    "@types/node": "^22.20.0",
    "markdown-it": "15.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-command-feedback": "0.1.5-alpha.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PelyDeng/dsh-plugin-manager.git",
    "directory": "plugins/dsh-example"
  }
}
