{
  "name": "@dsh-plugin-manager/plugin-manager",
  "version": "0.15.0",
  "description": "Package and deploy independent DSH applications with optional shared access management",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "dsh-plugin-manager": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/deployment.mjs",
    "./catalog": "./dist/plugins.mjs",
    "./packaging": "./dist/package-plugins.mjs",
    "./verification": "./dist/verification.mjs"
  },
  "files": [
    "dist",
    "runtime",
    "LICENSE",
    "README.md",
    "DELIVERY.md",
    "VERIFICATION.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PelyDeng/dsh-plugin-manager.git",
    "directory": "packages/plugin-manager"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@dsh-plugin-manager/plugin-kit": "workspace:*",
    "tsdown": "^0.22.2"
  }
}
