{
  "name": "@dsh-plugin-manager/plugin-kit",
  "version": "0.15.2",
  "description": "Optional identity, HTTP and tool integration for DSH plugins",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./access": {
      "types": "./dist/access.d.mts",
      "default": "./dist/access.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "default": "./dist/http.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "default": "./dist/tools.mjs"
    },
    "./conversations": {
      "types": "./dist/conversations.d.mts",
      "default": "./dist/conversations.mjs"
    },
    "./models": {
      "types": "./dist/models.d.mts",
      "default": "./dist/models.mjs"
    },
    "./route-path": {
      "types": "./src/route-path.d.mts",
      "default": "./src/route-path.mjs"
    },
    "./package.json": "./package.json",
    "./model-key": {
      "types": "./src/model-key.d.mts",
      "default": "./src/model-key.mjs"
    },
    "./deepseek-key": {
      "types": "./src/deepseek-key.d.mts",
      "default": "./src/deepseek-key.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src/route-path.mjs",
    "src/route-path.d.mts",
    "src/deepseek-key.mjs",
    "src/deepseek-key.d.mts",
    "src/model-key.mjs",
    "src/model-key.d.mts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PelyDeng/dsh-plugin-manager.git",
    "directory": "packages/plugin-kit"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
