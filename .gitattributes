*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
/plugins/builtin/dsh-auth/*.yml text eol=lf
/plugins/builtin/dsh-auth/**/*.ts text eol=lf
/plugins/builtin/dsh-auth/**/*.tsx text eol=lf
/plugins/builtin/dsh-example/knowledge/*.md text eol=lf
# 配置按字节参与解析与输入快照摘要，换行必须跨平台一致；没有这些规则时 Windows 的
# core.autocrlf 会让它们随检出变化，并在每次 git add 时报 LF/CRLF 转换警告。
/env.conf text eol=lf
/env.conf.example text eol=lf
/plugins/external/*/env.conf text eol=lf

/data export-ignore
/.local export-ignore
/deploy-artifacts export-ignore
/.tmp export-ignore
**/env.conf export-ignore
/deploy/config/deployment.json export-ignore
/deploy/config/host-image.json export-ignore
/deploy/config/host-image.conf export-ignore
