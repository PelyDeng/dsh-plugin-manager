# Copy outside version control; chmod 0600 on Linux. Paths resolve from repository root.
HARBOR_ENABLED=false
ALLOW_UPSTREAM=true
REGISTRY_HOST=
BASE_PROJECT=library
APP_PROJECT=dsh
IMAGE_NAME=dsh-host
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
DSH_SOURCE_BASE_IMAGE=docker.io/library/node:24-bookworm-slim
DSH_DEBIAN_MIRROR=http://deb.debian.org
DSH_IMAGE_PLATFORM=linux/amd64
